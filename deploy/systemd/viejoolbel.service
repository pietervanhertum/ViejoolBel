[Unit]
Description=ViejoolBel school bell system
After=network-online.target sound.target time-sync.target
Wants=network-online.target
# Never stop trying to restart the bell service, even after repeated crashes.
StartLimitIntervalSec=0

[Service]
# Type=notify so the app signals READY=1 on startup and pets the systemd
# watchdog (WATCHDOG=1); a hung process is then killed and restarted (NFR-2).
Type=notify
NotifyAccess=all
User=viejoolbel
Group=viejoolbel
# The "current" symlink is flipped atomically by the updater (see apply_update.sh).
WorkingDirectory=/opt/viejoolbel/current
Environment=VIEJOOLBEL_DATA_DIR=/var/lib/viejoolbel
Environment=VIEJOOLBEL_HARDWARE=auto
EnvironmentFile=-/etc/viejoolbel/viejoolbel.env
ExecStart=/opt/viejoolbel/current/.venv/bin/viejoolbel run
# Always come back — after a crash and automatically after a power cut on boot.
Restart=always
RestartSec=3
TimeoutStartSec=60
# The health monitor pings the watchdog every ~10 s; 30 s gives ample margin.
WatchdogSec=30
# Hardening
# NOTE: we deliberately do NOT set NoNewPrivileges=true. The web app performs its
# privileged actions (self-update, service restart, reboot, WiFi changes) by
# invoking a handful of tightly-scoped helpers through sudo (see
# deploy/sudoers.d/viejoolbel). NoNewPrivileges propagates to every child process
# and blocks setuid binaries, so with it set sudo fails with "the 'no new
# privileges' flag is set" and the update button does nothing. The privilege
# surface is instead constrained by the exact-command sudoers allowlist (NFR-4).
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
# The in-app updater (deploy/apply_update.sh, run as root via sudo) refreshes the
# unit and sudoers rule from each new release. ProtectSystem=full otherwise makes
# /etc read-only for the service and its children, so expose just these two paths
# read-write; everything else under /etc stays protected.
ReadWritePaths=/etc/systemd/system /etc/sudoers.d

[Install]
WantedBy=multi-user.target
